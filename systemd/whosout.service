# A systemd user unit. `just install` copies it to ~/.config/systemd/user.
# Settings come from ~/.config/whosout/env. See .env.example for the variables.
[Unit]
Description=whosout: serve the who-is-out calendar
After=network-online.target

[Service]
EnvironmentFile=%h/.config/whosout/env
ExecStart=%h/.local/bin/whosout serve
Restart=on-failure
RestartSec=10
StandardError=append:%h/.local/state/whosout/serve.log

[Install]
WantedBy=default.target
