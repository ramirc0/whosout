# A systemd user unit. `just install` copies it to ~/.config/systemd/user.
# Settings come from ~/.config/whosout/env. See .env.example for the variables.
[Unit]
Description=whosout: pull the status channel whenever Slack reports a change
After=network-online.target
# Slack sends each event to one open connection, so a second listener would steal events from this one.
# If several hosts share your home directory, pin this unit to one of them with ConditionHost= in a drop-in.

[Service]
EnvironmentFile=%h/.config/whosout/env
ExecStart=%h/.local/bin/whosout listen
Restart=always
RestartSec=30
StandardError=append:%h/.local/state/whosout/listen.log

[Install]
WantedBy=default.target
