# Copy to .env (Docker Compose, just) or to ~/.config/whosout/env (systemd), then fill in.

# User token (xoxp-...) with the channels:history and users:read user scopes. It reads the channel.
SLACK_USER_TOKEN=
# App-level token (xapp-...) with connections:write. It opens the Socket Mode connection.
SLACK_APP_TOKEN=
# Id of the status channel. Find it at the end of the channel's link.
SLACK_CHANNEL=C0123456789
# URL of the workspace, used for links back to messages.
SLACK_WORKSPACE=https://example.slack.com
# Time zone in which "today" and "tomorrow" are read.
WHOSOUT_TIME_ZONE=America/New_York
# Host port for the calendar under Docker Compose.
WHOSOUT_PORT=8377
